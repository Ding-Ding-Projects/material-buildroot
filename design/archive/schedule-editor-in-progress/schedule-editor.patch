+const empty=():ScheduleDocument=>({schemaVersion:1,revision:0,timeZone:Intl.DateTimeFormat().resolvedOptions().timeZone||'UTC',rules:[]});
+export class ScheduledPreferencesPanel extends LitElement{
+ static properties={language:{type:String},restricted:{type:Boolean},snapshot:{attribute:false},baseLanguage:{type:String},baseTheme:{type:String},revision:{state:true}};
+ language='en';restricted=true;snapshot:ScheduledPreferencesSnapshot|null=null;baseLanguage='bilingual';baseTheme='system';revision=0;
+ private document=empty();private baseline=JSON.stringify(this.document);private expectedRevision:number|null=null;private loaded=false;private pending=false;private refreshing=false;private uncertain=false;private conflict=false;private selected='';private feedback='';private validation='';private history?:ScheduledHistoryPage;private confirmAction?:()=>void;private confirmResolve?:(ok:boolean)=>void;
+ static styles=css`.rule,.record,.status{transition:background-color 140ms ease,border-color 140ms ease}.record,.status{animation:state-enter 120ms ease-out}@keyframes state-enter{from{opacity:.6}to{opacity:1}}@media(prefers-reduced-motion:reduce){.rule,.record,.status{transition:none;animation:none}}:host{display:block;color:inherit;font:inherit}.stack{display:grid;gap:12px}.row{display:flex;flex-wrap:wrap;align-items:center;gap:8px}h2{font-size:20px;margin:0}h3{font-size:16px;margin:0}p{margin:4px 0;overflow-wrap:anywhere}.layout{display:grid;grid-template-columns:minmax(190px,1fr) minmax(0,2fr);gap:16px}.rules{display:grid;align-content:start;gap:6px}.rule{padding:8px;border:1px solid var(--md-sys-color-outline-variant)}.rule.selected{background:var(--md-sys-color-secondary-container)}.rule-title{max-width:100%;overflow-wrap:anywhere}.rule-title md-text-button{max-width:100%;height:auto;min-height:48px}.editor{min-width:0;border-left:1px solid var(--md-sys-color-outline-variant);padding-left:16px}.fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}md-outlined-text-field,md-outlined-select{width:100%;min-width:0}md-outlined-button,md-filled-button,md-text-button,md-icon-button{min-height:48px}md-icon-button{min-width:48px}.days label{display:flex;align-items:center;min-height:48px}.status{padding:10px;background:var(--md-sys-color-surface-container-low);border:1px solid var(--md-sys-color-outline-variant)}.timeline{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:2px}.day{padding:6px 2px;text-align:center;background:var(--md-sys-color-surface-container-high);font-size:12px}.day.active{background:var(--md-sys-color-primary-container);color:var(--md-sys-color-on-primary-container)}.history{display:grid;gap:8px}.error{color:var(--md-sys-color-error)}md-dialog{max-width:min(560px,94vw)}@media(max-width:1100px){.layout{grid-template-columns:1fr}.editor{border-left:0;border-top:1px solid var(--md-sys-color-outline-variant);padding:12px 0 0}}@media(max-width:600px){.fields{grid-template-columns:1fr}}`;
+ private l(en:string,zh:string){return this.language==='en'?en:this.language==='zh-HK'?zh:`${en} · ${zh}`;}
+ private get dirty(){return JSON.stringify(this.document)!==this.baseline;}
+ private get hiddenRules(){return this.restricted&&this.document.rules.some(r=>'language' in r.values);}
+ private get protectedChanges(){if(!this.restricted)return false;const original=JSON.parse(this.baseline) as ScheduleDocument;return JSON.stringify(original.rules.filter(r=>'language' in r.values))!==JSON.stringify(this.document.rules.filter(r=>'language' in r.values))||original.timeZone!==this.document.timeZone&&this.hiddenRules;}
+ private get rule(){return this.document.rules.find(r=>r.id===this.selected&&(!this.restricted||!('language' in r.values)));}
+ private get canEdit(){return this.loaded&&!this.pending&&!this.uncertain&&this.snapshot?.available===true;}
+ private change(){this.validation='';this.revision++;}
+ private beforeUnload=(e:BeforeUnloadEvent)=>{if(this.dirty||this.pending){e.preventDefault();e.returnValue='';}};
+ connectedCallback(){super.connectedCallback();window.addEventListener('beforeunload',this.beforeUnload);void this.read();}
+ disconnectedCallback(){window.removeEventListener('beforeunload',this.beforeUnload);this.confirmResolve?.(false);super.disconnectedCallback();}
+ protected updated(changes:PropertyValues){if(changes.has('snapshot')&&this.loaded&&this.snapshot?.revision!==this.expectedRevision){this.conflict=true;this.revision++;}}
+ private async call(request:ScheduledPreferencesRequest){const reply=await window.studio?.scheduledPreferences?.(request);if(!reply?.ok)throw Error(reply?.code||'UNAVAILABLE');return reply.result;}
+ private fail(e:unknown){const code=e instanceof Error&&/^[A-Z_]+$/.test(e.message)?e.message:'UNAVAILABLE';this.feedback=captureOwnedStatus(this,'feedback',this.l.bind(this),l=>l('Schedule operation not confirmed. Your draft is retained. Read the stored revision before retrying.','未能確認排程操作，草稿已保留。重試前請讀取已儲存版本。')+' '+code);return code;}
+ private publish(snapshot:ScheduledPreferencesSnapshot|null){this.dispatchEvent(new CustomEvent('scheduled-snapshot',{detail:snapshot,bubbles:true,composed:true}));}
+ private async read(){if(this.pending)return;this.pending=true;this.revision++;try{const stored=await this.call({action:'read'}) as ScheduleDocument|null;if(this.dirty){this.conflict=stored?.revision!==this.expectedRevision;this.uncertain=false;this.feedback=captureOwnedStatus(this,'feedback',this.l.bind(this),l=>l('Stored revision inspected. Your unsaved draft was retained; reload and discard it explicitly to use the stored version.','已檢視儲存版本並保留未儲存草稿，要使用已儲存版本請明確重新載入並放棄草稿。'));}else{this.document=stored??empty();this.expectedRevision=stored?.revision??null;this.baseline=JSON.stringify(this.document);this.loaded=true;this.conflict=false;this.uncertain=false;this.selected=this.document.rules.find(r=>!this.restricted||!('language'in r.values))?.id||'';}const snapshot=await this.call({action:'status'}) as ScheduledPreferencesSnapshot;this.publish(snapshot);}catch(e){this.fail(e);}finally{this.pending=false;this.revision++;}}
+ private async reload(){if(this.dirty){this.confirmAction=()=>{this.document=JSON.parse(this.baseline);void this.read();};await this.updateComplete;(this.shadowRoot?.querySelector('md-dialog') as any)?.show();}else await this.read();}
+ private options(){const origins=this.document.rules.flatMap(r=>r.source.type==='local'?[]:[new URL(r.source.type==='https'?r.source.url:r.source.baseUrl).origin]);return {registry,allowedOrigins:origins};}
+ private validate(){try{validateScheduleDocument(this.document,this.options());this.validation='';return true;}catch(e){this.validation=(e as {code?:string}).code||'INVALID_RULE';return false;}}
+ async save(){if(!this.canEdit||this.conflict||this.protectedChanges||!this.validate()){this.revision++;return false;}this.pending=true;this.revision++;try{const saved=await this.call({action:'replace',document:structuredClone(this.document),expectedRevision:this.expectedRevision}) as ScheduleDocument;this.document=saved;this.expectedRevision=saved.revision;this.baseline=JSON.stringify(saved);this.conflict=false;this.feedback=captureOwnedStatus(this,'feedback',this.l.bind(this),l=>l('Schedule saved. Effective values are reported by the host; base preferences were not changed.','排程已儲存，有效值由主機回報，基礎偏好未變更。'));this.publish(await this.call({action:'status'}) as ScheduledPreferencesSnapshot);return true;}catch(e){const code=this.fail(e);if(code==='STALE_REVISION')this.conflict=true;else this.uncertain=true;return false;}finally{this.pending=false;this.revision++;}}
+ async confirmLeave(){if(this.pending)return false;if(!this.dirty)return true;this.confirmAction=undefined;await this.updateComplete;(this.shadowRoot?.querySelector('md-dialog') as any)?.show();return new Promise<boolean>(resolve=>this.confirmResolve=resolve);}
+ private closeConfirm(ok:boolean){(this.shadowRoot?.querySelector('md-dialog') as any)?.close();const resolve=this.confirmResolve;this.confirmResolve=undefined;resolve?.(ok);}
+ private discard(){this.document=JSON.parse(this.baseline);this.validation='';this.revision++;const action=this.confirmAction;this.confirmAction=undefined;if(action)action();this.closeConfirm(true);}
+ private async refresh(){if(this.refreshing)return;this.refreshing=true;this.revision++;try{this.publish(await this.call({action:'refresh'}) as ScheduledPreferencesSnapshot);}catch(e){this.fail(e);this.publish(null);}finally{this.refreshing=false;this.revision++;}}
+ private async cancel(){try{this.publish(await this.call({action:'cancel'}) as ScheduledPreferencesSnapshot);this.feedback=captureOwnedStatus(this,'feedback',this.l.bind(this),l=>l('External requests cancelled for the host pause interval. Local rules remain active; disable and save a rule to stop its override.','已喺主機暫停期間取消外部要求，本機規則仍然有效；停用並儲存規則先會停止覆寫。'));}catch(e){this.fail(e);}this.revision++;}
+ private async readHistory(more=false){if(this.pending)return;this.pending=true;this.revision++;try{const page=await this.call({action:'history',after:more?this.history?.next??0:0,limit:25}) as ScheduledHistoryPage;this.history={...page,records:more?[...(this.history?.records||[]),...page.records]:page.records};}catch(e){this.fail(e);}finally{this.pending=false;this.revision++;}}
+ private add(){if(!this.canEdit||this.document.rules.length>=256)return;const r:ScheduleRule={id:crypto.randomUUID(),label:this.l('New rule','新規則'),enabled:true,priority:0,startDate:null,endDate:null,startTime:'09:00',endTime:'17:00',days:{type:'everyday'},values:{'appearance.theme':'dark'},source:{type:'local'}};this.document.rules.push(r);this.selected=r.id;this.change();}
+ private move(id:string,direction:number){const index=this.document.rules.findIndex(r=>r.id===id),next=index+direction;if(next<0||next>=this.document.rules.length)return;[this.document.rules[index],this.document.rules[next]]=[this.document.rules[next],this.document.rules[index]];this.change();}
+ private field(label:string,zh:string,value:string,set:(value:string)=>void,type='text'){return html`<md-outlined-text-field .label=${this.l(label,zh)} .value=${value} type=${type} ?disabled=${!this.canEdit} @input=${(e:Event)=>{set((e.target as HTMLInputElement).value);this.change();}}></md-outlined-text-field>`;}
