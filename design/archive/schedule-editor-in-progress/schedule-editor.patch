+ private theme(value:string){return value==='system'?this.l('Follow system','跟隨系統'):value==='dark'?this.l('Dark','深色'):this.l('Light','淺色');}
+ private languageName(value:string){return value==='en'?'English':value==='zh-HK'?'香港粵語':'English + 香港粵語';}
+ private days(){return [['Sun','日'],['Mon','一'],['Tue','二'],['Wed','三'],['Thu','四'],['Fri','五'],['Sat','六']];}
+ private editor(r:ScheduleRule){return html`<div class="editor stack"><h3>${this.l('Rule editor','規則編輯器')}</h3>${r.source.type!=='local'?html`<p>${this.l('This existing external rule is preserved. Source setup is unavailable in this editor.','保留此現有外部規則，此編輯器未提供來源設定。')}</p>`:nothing}<div class="fields">${this.field('Rule label','規則標籤',r.label,v=>r.label=v)}${this.field('Priority (−1000 to 1000)','優先次序（−1000 至 1000）',String(r.priority),v=>r.priority=v===''?NaN:Number(v),'number')}${this.field('Start date (optional)','開始日期（可選）',r.startDate||'',v=>r.startDate=v||null,'date')}${this.field('End date (optional)','結束日期（可選）',r.endDate||'',v=>r.endDate=v||null,'date')}${this.field('Start time','開始時間',r.startTime,v=>r.startTime=v,'time')}${this.field('End time','結束時間',r.endTime,v=>r.endTime=v,'time')}</div><p>${this.l('Dates are inclusive. Start is inclusive and end exclusive. Equal times mean the whole selected calendar day; an end before start crosses midnight and belongs to the starting day.','日期包括首尾日，開始時間包括在內，結束時間除外。時間相同代表整個所選曆日，結束早過開始會跨午夜並屬於開始嗰日。')}</p><label class="row"><md-checkbox aria-label=${this.l('Every day','每日')} ?checked=${r.days.type==='everyday'} ?disabled=${!this.canEdit} @change=${(e:Event)=>{r.days=(e.target as HTMLInputElement).checked?{type:'everyday'}:{type:'weekdays',weekdays:[1,2,3,4,5]};this.change();}}></md-checkbox>${this.l('Every day','每日')}</label>${r.days.type==='weekdays'?html`<div class="row days">${this.days().map(([en,zh],day)=>html`<label><md-checkbox aria-label=${this.l(en,zh)} ?checked=${r.days.type==='weekdays'&&r.days.weekdays.includes(day)} ?disabled=${!this.canEdit} @change=${(e:Event)=>{if(r.days.type==='weekdays')r.days.weekdays=(e.target as HTMLInputElement).checked?[...r.days.weekdays,day]:r.days.weekdays.filter(d=>d!==day);this.change();}}></md-checkbox>${this.l(en,zh)}</label>`)}</div>`:nothing}<div class="timeline" aria-label=${this.l('Selected weekdays','已選星期')} role="group">${this.days().map(([en,zh],day)=>html`<span class=${`day ${r.days.type==='everyday'||r.days.weekdays.includes(day)?'active':''}`}>${this.l(en,zh)}</span>`)}</div><h3>${this.l('Temporary values','暫時值')}</h3><label class="row"><md-checkbox aria-label=${this.l('Override theme','覆寫主題')} ?checked=${'appearance.theme'in r.values} ?disabled=${!this.canEdit} @change=${(e:Event)=>{if((e.target as HTMLInputElement).checked)r.values['appearance.theme']='dark';else delete r.values['appearance.theme'];this.change();}}></md-checkbox>${this.l('Override theme','覆寫主題')}</label>${'appearance.theme'in r.values?this.select('Scheduled theme','排程主題',String(r.values['appearance.theme']),['system','light','dark'].map(v=>[v,this.theme(v)]),v=>r.values['appearance.theme']=v):nothing}${!this.restricted?html`<label class="row"><md-checkbox aria-label=${this.l('Override language','覆寫語言')} ?checked=${'language'in r.values} ?disabled=${!this.canEdit} @change=${(e:Event)=>{if((e.target as HTMLInputElement).checked)r.values.language='en';else delete r.values.language;this.change();}}></md-checkbox>${this.l('Override language','覆寫語言')}</label>${'language'in r.values?this.select('Scheduled language','排程語言',String(r.values.language),['en','zh-HK','bilingual'].map(v=>[v,this.languageName(v)]),v=>r.values.language=v):nothing}`:nothing}<md-outlined-button ?disabled=${!this.canEdit} @click=${()=>{this.document.rules=this.document.rules.filter(rule=>rule.id!==r.id);this.selected='';this.change();}}>${materialIcon('delete','icon')}${this.l('Delete rule from draft','從草稿刪除規則')}</md-outlined-button></div>`;}
+ render(){const s=this.snapshot,eff=s?.available?s.effective:null;return html`<div class="stack"><h2 id="schedule-heading" tabindex="-1">${this.l('Scheduled preferences','偏好排程')}</h2><p>${this.l('Rules temporarily override saved preferences in the chosen timezone. Higher priority wins; at equal priority the later rule wins per setting. Ending or disabling an override restores another matching rule or the saved base.','規則會喺所選時區暫時覆寫已儲存偏好，優先次序較高者生效，同級時較後規則按設定勝出。覆寫結束或停用後會恢復其他符合規則或已儲存基礎值。')}</p><div class="status stack"><strong>${s?.available?this.l('Host schedule available','主機排程可用'):this.l('Host schedule unavailable; saved base preferences apply.','主機排程未能使用，採用已儲存基礎偏好。')}</strong><p>${this.l('Base theme','基礎主題')}: ${this.theme(this.baseTheme)} · ${this.l('Effective theme','有效主題')}: ${this.theme(String(eff?.values['appearance.theme']||this.baseTheme))} · ${this.l('Rule','規則')}: ${eff?.provenance['appearance.theme']||this.l('Saved base','已儲存基礎值')}</p>${!this.restricted?html`<p>${this.l('Base language','基礎語言')}: ${this.languageName(this.baseLanguage)} · ${this.l('Effective language','有效語言')}: ${this.languageName(String(eff?.values.language||this.baseLanguage))} · ${this.l('Rule','規則')}: ${eff?.provenance.language||this.l('Saved base','已儲存基礎值')}</p>`:html`<p>Shared preference restrictions take precedence. Restricted controls and rule details are omitted; stored values are preserved.</p>`}<p>${this.l('Evaluated at','評估時間')}: ${s?.evaluatedAt?new Date(s.evaluatedAt).toISOString():this.l('Unknown','未知')} · ${this.l('Revision','版本')}: ${s?.revision??this.l('Not stored','未儲存')}</p>${eff?.issues.length?html`<p>${this.l('Some rules have unavailable source results. Inspect host source setup when available.','部分規則來源結果未能使用，主機來源設定可用時請檢視。')}</p>${!this.restricted?eff.issues.map(i=>html`<p>${i.ruleId} · ${i.code}</p>`):nothing}`:nothing}<p>${s?.externalAvailable?this.l('External capability is enrolled by the host. Source editing is not connected here yet.','主機已登記外部能力，此處尚未連接來源編輯。'):this.l('External source setup is unavailable. Local rules work without network access.','外部來源設定未能使用，本機規則毋須網絡。')}</p></div><div class="row"><md-outlined-button ?disabled=${this.pending} @click=${()=>this.read()}>${materialIcon('info','icon')}${this.l('Read stored revision','讀取儲存版本')}</md-outlined-button><md-outlined-button ?disabled=${this.pending} @click=${()=>this.reload()}>${materialIcon('refresh','icon')}${this.l('Reload schedule','重新載入排程')}</md-outlined-button><md-outlined-button ?disabled=${this.refreshing||!s?.available} @click=${this.refresh}>${materialIcon('sync','icon')}${this.l('Refresh effective values','更新有效值')}</md-outlined-button><md-outlined-button ?disabled=${!s?.available} @click=${this.cancel}>${materialIcon('stop','icon')}${this.l('Cancel external requests','取消外部要求')}</md-outlined-button></div>${this.conflict?html`<p class="error" role="status">${this.l('Stored revision changed. Your draft is preserved; reload explicitly before saving.','儲存版本已變更，草稿已保留，儲存前請明確重新載入。')}</p>`:nothing}${this.protectedChanges?html`<p role="status">Some pending edits are restricted. Keep the draft until the shared preference permits them, or reload and discard explicitly.</p>`:nothing}<md-outlined-text-field .label=${this.l('Schedule timezone','排程時區')} .value=${this.document.timeZone} ?disabled=${!this.canEdit||this.hiddenRules} supporting-text=${this.l('IANA timezone, for example Asia/Hong_Kong or UTC.','IANA 時區，例如 Asia/Hong_Kong 或 UTC。')} @input=${(e:Event)=>{this.document.timeZone=(e.target as HTMLInputElement).value;this.change();}}></md-outlined-text-field><div class="row"><md-outlined-button ?disabled=${!this.canEdit||this.document.rules.length>=256} @click=${this.add}>${materialIcon('add','icon')}${this.l('Add local rule','新增本機規則')}</md-outlined-button><md-filled-button ?disabled=${!this.canEdit||!this.dirty||this.conflict||this.protectedChanges} @click=${()=>this.save()}>${materialIcon('save','icon')}${this.l('Save schedule','儲存排程')}</md-filled-button><span>${this.dirty?this.l('Unsaved draft','未儲存草稿'):this.l('No pending edits','冇待儲存變更')}</span></div>${this.validation?html`<p role="alert" class="error">${this.l('Check the timezone, calendar dates, time window, weekdays, priority and at least one temporary value.','請檢查時區、日期、時間範圍、星期、優先次序及至少一個暫時值。')} ${this.validation}</p>`:nothing}${this.hiddenRules?html`<p>Restricted rules are preserved and omitted from this editor.</p>`:nothing}<div class="layout"><div class="rules" aria-label=${this.l('Ordered schedule rules','已排序排程規則')}>${this.document.rules.filter(r=>!this.restricted||!('language'in r.values)).map(r=>html`<section class=${`rule ${this.selected===r.id?'selected':''}`}><div class="rule-title"><md-text-button aria-pressed=${this.selected===r.id} @click=${()=>{this.selected=r.id;this.revision++;}}>${materialIcon('edit','icon')}${r.label}</md-text-button></div><p>${r.startTime}–${r.endTime} · ${this.l('Priority','優先次序')} ${r.priority}</p><div class="row"><md-switch aria-label=${this.l('Enable rule','啟用規則')+' '+r.label} ?selected=${r.enabled} ?disabled=${!this.canEdit} @change=${(e:Event)=>{r.enabled=(e.target as HTMLInputElement&{selected:boolean}).selected;this.change();}}></md-switch>${([-1,1] as const).map(d=>html`<md-icon-button aria-label=${this.l(d<0?'Move rule earlier':'Move rule later',d<0?'將規則移前':'將規則移後')+' '+r.label} title=${this.l(d<0?'Move rule earlier':'Move rule later',d<0?'將規則移前':'將規則移後')} ?disabled=${!this.canEdit||this.hiddenRules||(d<0?this.document.rules.indexOf(r)===0:this.document.rules.indexOf(r)===this.document.rules.length-1)} @click=${()=>this.move(r.id,d)}>${materialIcon(d<0?'arrow_upward':'arrow_downward')}</md-icon-button>`)}</div></section>`)}</div>${this.rule?this.editor(this.rule):html`<p>${this.l('Add or select a local rule to edit its calendar window and temporary values.','新增或選擇本機規則以編輯日期範圍同暫時值。')}</p>`}</div><section class="history"><div class="row"><h3>${this.l('Schedule history','排程歷史')}</h3><md-outlined-button ?disabled=${this.pending} @click=${()=>this.readHistory()}>${materialIcon('history','icon')}${this.l('Read schedule history','讀取排程歷史')}</md-outlined-button></div>${this.history?.records.map(r=>html`<p>${r.sequence} · ${r.receipt.action} · ${r.receipt.fromRevision??'—'} → ${r.receipt.toRevision}</p>`)}${this.history&&!this.history.records.length?html`<p>${this.l('No recorded schedule revisions.','冇排程版本記錄。')}</p>`:nothing}${this.history?.hasMore?html`<md-text-button ?disabled=${this.pending} @click=${()=>this.readHistory(true)}>${materialIcon('arrow_forward','icon')}${this.l('More history','更多歷史')}</md-text-button>`:nothing}</section><p role="status">${displayOwnedStatus(this,'feedback',this.feedback,this.language)}</p></div><md-dialog @cancel=${()=>this.closeConfirm(false)}><div slot="headline">${this.l('Unsaved schedule draft','未儲存排程草稿')}</div><div slot="content">${this.l('Keep editing, or explicitly discard the draft. Saving commits the complete reviewed rule list.','可以繼續編輯，或明確放棄草稿。儲存會提交整份已審核規則清單。')}</div><div slot="actions"><md-text-button @click=${()=>this.closeConfirm(false)}>${this.l('Keep editing','繼續編輯')}</md-text-button><md-outlined-button @click=${this.discard}>${materialIcon('close','icon')}${this.l('Discard schedule draft','放棄排程草稿')}</md-outlined-button>${!this.confirmAction?html`<md-filled-button ?disabled=${!this.canEdit||this.conflict||this.protectedChanges} @click=${async()=>{if(await this.save())this.closeConfirm(true);}}>${materialIcon('save','icon')}${this.l('Save and continue','儲存並繼續')}</md-filled-button>`:nothing}</div></md-dialog>`;}
