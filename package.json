{
  "name": "material-buildroot",
  "version": "0.1.0",
  "description": "Windows desktop workspace for Buildroot with WSL and Docker execution.",
  "author": "Ding-Ding Projects",
  "license": "GPL-3.0-or-later",
  "main": "src/main/index.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "electron .",
    "build": "build.bat /s",
    "test": "node --test tests/*.test.cjs",
    "package:win": "build.bat /s",
    "dist:win": "build-installer.bat /s"
  },
  "dependencies": {
    "@material/web": "2.5.0",
    "ajv": "8.20.0",
    "electron-squirrel-startup": "1.0.1",
    "jsonc-parser": "3.3.1",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "electron-builder-squirrel-windows": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "com.dingdingprojects.materialbuildroot",
    "productName": "Material Buildroot",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/shared/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "squirrel",
          "arch": [
            "x64"
          ]
        }
      ],
      "forceCodeSigning": false,
      "signAndEditExecutable": false
    },
    "squirrelWindows": {
      "name": "MaterialBuildroot",
      "artifactName": "Setup.${ext}",
      "iconUrl": "https://github.com/favicon.ico",
      "msi": false
    }
  }
}
