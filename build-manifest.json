{
  "schemaVersion": 1,
  "platform": "win32-x64",
  "toolchains": [
    {
      "id": "node",
      "version": "24.22.0",
      "url": "https://nodejs.org/dist/v24.22.0/node-v24.22.0-win-x64.zip",
      "sha256": "f9683a19877e12a9b167305c8db71040d812876359de21f0d2e97c3f321f80c3",
      "stripPrefix": "node-v24.22.0-win-x64/",
      "required": ["node.exe", "node_modules/npm/bin/npm-cli.js"],
      "maxDownloadBytes": 100000000,
      "maxExpandedBytes": 600000000
    },
    {
      "id": "git",
      "version": "2.56.0.2",
      "url": "https://github.com/git-for-windows/git/releases/download/v2.56.0.windows.2/MinGit-2.56.0.2-64-bit.zip",
      "sha256": "da35e72aa21c005a5a0d298cfbae110bc1609a815730ea0dde84b01a1b3cd3be",
      "stripPrefix": "",
      "required": ["cmd/git.exe"],
      "maxDownloadBytes": 100000000,
      "maxExpandedBytes": 600000000
    }
  ],
  "targets": {
    "design-reference": {
      "kind": "static-reference",
      "input": "design/reference/index.html",
      "output": "dist-design",
      "entry": "design/reference/index.html",
      "command": ["node_modules/vite/bin/vite.js", "build", "--config", "design/reference/vite.config.mjs", "--outDir", "{output}"],
      "launch": null,
      "installable": false
    },
    "documentation": {
      "kind": "static-documentation",
      "input": "website/build.mjs",
      "packageDirectory": "website",
      "output": ".cache/documentation-output",
      "entry": "index.html",
      "command": [
        "website/build.mjs",
        "--output",
        "{output}"
      ],
      "checkCommand": [
        "website/check.mjs",
        "--output",
        "{output}"
      ],
      "launch": null,
      "installable": false
    },
    "desktop": {
      "kind": "desktop",
      "input": "src/main/index.cjs",
      "rendererInput": "src/renderer/main.ts",
      "output": "release/app",
      "entry": "win-unpacked/Material Buildroot.exe",
      "archive": "win-unpacked/resources/app.asar",
      "command": ["node_modules/electron-builder/out/cli/cli.js", "--win", "dir", "--x64", "--publish", "never", "--config.directories.output={output}"],
      "rendererCommand": ["node_modules/vite/bin/vite.js", "build"],
      "installerCommand": ["node_modules/electron-builder/out/cli/cli.js", "--win", "squirrel", "--x64", "--publish", "never", "--config.directories.output={output}"],
      "installerOutput": "release/installer",
      "launch": "win-unpacked/Material Buildroot.exe",
      "installable": true
    }
  },
  "electron": {
    "version": "44.7.2",
    "url": "https://github.com/electron/electron/releases/download/v44.7.2/electron-v44.7.2-win32-x64.zip",
    "sha256": "10a89447ef64ac5cb9f782af48ffd83734a40ae91681259d1048ca3c9e6c5da4",
    "maxDownloadBytes": 200000000,
    "maxExpandedBytes": 700000000,
    "stripPrefix": "",
    "required": ["electron.exe", "resources/default_app.asar"],
    "id": "electron"
  }
}
